---
// Framework Makewell (redesign, artboard Framework.dc.html). Texto completo do site atual em src/content/framework.ts.
import Page from '../layouts/Page.astro';
import { path, type Lang, type PageKey } from '../lib/site';
import C from '../content/framework';

interface Props { page: { htmlAttrs: string; head: string; body: string }; key: PageKey; lang: Lang }
const { page, key, lang } = Astro.props;
const t = C[lang];
const relImg = { method: '/images/escritorio-estante.webp', howWeCreate: '/images/escritorio-camera-livros.webp', services: '/images/escritorio-sala.webp' };
const hunter = (s: string) => s.replace('Casa Hunter', `<a href="${path('casaHunter', lang)}"><strong>Casa Hunter</strong></a>`);
---
<Page page={page} key={key} lang={lang}>

  <section class="t-warm sec fw-hero">
    <div class="wrap">
      <p class="eyebrow dot fw-eb-muted">{t.kicker}</p>
      <h1 class="h1 fw-h1"><span>{t.h1a}</span> <em>{t.h1b}</em></h1>
      <div class="fw-hero-row">
        <div class="fw-hero-text">
          <div>
            <p class="lead">{t.lead}</p>
            <div class="btns">
              <a class="btn btn-primary" href="#diagnostico">{t.ctaHero}</a>
              <a class="btn btn-ghost" href={`#${t.ids.pillars}`}>{t.ctaSec}</a>
            </div>
          </div>
          <div class="fw-stats">
            {t.stats.map(([n, l]) => <div><p class="fw-stat-n">{n}</p><p class="muted">{l}</p></div>)}
          </div>
        </div>
        <div class="fw-hero-img">
          <img class="photo" src="/images/escritorio-estudio.webp" alt={t.heroAlt} width="1210" height="908" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="t-light sec" id={t.ids.why}>
    <div class="wrap split">
      <div class="side">
        <p class="eyebrow fw-eb-dark">{t.whyEyebrow}</p>
        <h2 class="h2">{t.whyTitle}</h2>
        <img class="photo fw-why-img" src="/images/escritorio-campanhas.webp" alt={t.whyAlt} width="1210" height="610" loading="lazy" />
      </div>
      <div class="side prose fw-why-body">
        {t.whyBody.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="t-warm2 sec line-top fw-pil" id={t.ids.pillars}>
    <div class="wrap">
      <p class="eyebrow">{t.pilEyebrow}</p>
      <h2 class="h2 fw-pil-title">{t.pilTitle}</h2>
      <p class="lead">{t.pilSub}</p>
      <ol class="fw-flow">
        {t.flow.map(([label, title]) => <li><span class="fw-flow-dot" aria-hidden="true"></span><span class="fw-flow-label">{label}</span><span class="fw-flow-title">{title}</span></li>)}
      </ol>
      <div class="fw-pillars">
        {t.pillars.map((p, i) => (<>
          <article class="card fw-pillar">
            <div class="fw-pillar-head">
              <p class="fw-pillar-n" aria-hidden="true">0{i + 1}</p>
              <p class="fw-tag muted">{p.tag}</p>
              <h3 class="fw-pillar-title">{p.title}</h3>
              <p class="fw-pillar-lead">{p.lead}</p>
            </div>
            <div class="fw-pillar-body">
              <div class="prose"><p set:html={p.p1} /><p set:html={p.p2} /></div>
              <div class="fw-apply">
                <p class="eyebrow">{t.appLabel}</p>
                <p class="fw-apply-text">{p.app}</p>
              </div>
            </div>
          </article>
          {i === 1 && (
          <div class="card fw-criamos">
            <div>
              <p class="eyebrow">{t.criamos.badge}</p>
              <h3 class="h3">{t.criamos.title}</h3>
              <p>{t.criamos.text}</p>
            </div>
            <a class="btn btn-primary" href={path('howWeCreate', lang)}>{t.criamos.btn}</a>
          </div>
          )}
        </>))}
      </div>
    </div>
  </section>

  <section class="t-light sec" id={t.ids.vs}>
    <div class="wrap">
      <p class="eyebrow fw-eb-dark">{t.vsEyebrow}</p>
      <h2 class="h2 fw-vs-title" set:html={t.vsTitle} />
      <div class="grid fw-mt" style="--min: 300px">
        {[[t.vsFw, t.flow.map((f) => f[1])], [t.vsFish, t.vsFish.steps]].map(([c, chips]) => (
          <div class="card fw-vs-card">
            <p class="fw-tag muted">{c.kicker}</p>
            <h3 class="fw-vs-label">{c.label}</h3>
            <p>{c.desc}</p>
            <ul class="fw-chips" aria-hidden="true">{chips.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="fw-vs-note">
        <p class="muted" set:html={t.vsNote} />
        <a class="link-arrow fw-link-ink" href={path('method', lang)}>{t.vsLink}</a>
      </div>
    </div>
  </section>

  <section class="t-warm sec" id={t.ids.diff}>
    <div class="wrap">
      <p class="eyebrow">{t.diffEyebrow}</p>
      <h2 class="h2">{t.diffTitle}</h2>
      <p class="lead">{t.diffSub}</p>
      <div class="grid fw-mt" style="--min: 320px">
        {[[t.bad, false], [t.good, true]].map(([c, good]) => (
          <div class:list={['card fw-contrast', good ? 'fw-good' : 'fw-bad']}>
            <p class="fw-tag">{c.tag}</p>
            <h3 class="fw-vs-label">{c.title}</h3>
            <ul class="fw-list">
              {c.list.map((x) => (
                <li>
                  {good
                    ? <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>}
                  <span>{x}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="t-accent sec">
    <div class="wrap">
      <blockquote class="fw-quote">
        <p>{t.quote}</p>
        <p class="fw-cite muted">Makewell Comunicação</p>
      </blockquote>
    </div>
  </section>

  <section class="t-light sec" id={t.ids.who}>
    <div class="wrap">
      <p class="eyebrow fw-eb-dark">{t.forEyebrow}</p>
      <h2 class="h2">{t.forTitle}</h2>
      <p class="lead">{t.forSub}</p>
      <div class="grid fw-mt" style="--min: 250px">
        {t.segments.map((s, i) => (
          <div class="card fw-seg">
            <span class="num">0{i + 1}</span>
            <div><h3 class="h3">{s.title}</h3><p set:html={hunter(s.desc)} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="t-warm sec" id={t.ids.rel}>
    <div class="wrap">
      <p class="eyebrow">{t.relEyebrow}</p>
      <h2 class="h2">{t.relTitle}</h2>
      <p class="lead">{t.relSub}</p>
      <div class="grid fw-mt" style="--min: 300px">
        {t.related.map((r) => (
          <a class="fw-rel" href={path(r.key as PageKey, lang)}>
            <img src={relImg[r.key]} alt={r.alt} loading="lazy" />
            <span class="fw-rel-body">
              <span class="fw-tag muted">{r.tag}</span>
              <span class="fw-rel-title">{r.title}</span>
              <span class="muted fw-rel-desc">{r.desc}</span>
              <span class="fw-rel-link">{r.link}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="t-light sec" id="diagnostico">
    <div class="wrap">
      <div class="card fw-cta">
        <p class="eyebrow">{t.ctaEyebrow}</p>
        <h2 class="h2">{t.ctaTitle}</h2>
        <p class="lead">{t.ctaText}</p>
        <div class="btns">
          <a class="btn btn-primary" href={t.ctaHref} target="_blank" rel={t.ctaRel} data-track="lead" onclick={t.ctaOnclick}>{t.ctaBtn}</a>
        </div>
      </div>
    </div>
  </section>

</Page>

<style is:inline>
  main :is(.h1, .h2, .h3, .fw-pillar-title, .fw-quote p:first-child) { text-wrap: balance; }
  .fw-eb-muted { color: var(--muted); }
  .fw-h1 { max-width: 1120px; font-size: clamp(38px, 5.6vw, 84px); overflow-wrap: break-word; }
  .fw-hero-row { display: flex; flex-wrap: wrap; gap: 56px; margin-top: 56px; align-items: stretch; }
  .fw-hero-text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .fw-hero-text .lead { margin-top: 0; }
  .fw-hero-img { flex: 1 1 520px; min-width: 0; }
  .fw-hero-img img { height: 100%; min-height: 320px; aspect-ratio: 4 / 3; border-radius: 24px; }
  .fw-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .fw-stats > div { border-top: 1px solid var(--line); padding: 20px 0; }
  .fw-stats p { margin: 0; }
  .fw-stats .muted { margin-top: 8px; font-size: 14px; line-height: 1.4; }
  .fw-stat-n { font-size: 48px; font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .fw-why-img { aspect-ratio: 4 / 3; margin-top: 48px; border-radius: 24px; }
  .fw-why-body { padding-top: 8px; }
  .fw-why-body p { font-size: 18px; line-height: 1.7; margin-bottom: 24px; }
  .fw-mt { margin-top: 56px; }
  .fw-eb-dark, .t-light .fw-seg .num { color: #B4530F; }
  .fw-tag { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .fw-pil-title { max-width: 820px; font-size: clamp(36px, 5vw, 72px); line-height: 1; }
  .fw-flow { list-style: none; padding: 0; margin: 64px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px 24px; }
  .fw-flow li { border-top: 1px solid var(--line); display: flex; flex-direction: column; }
  .fw-flow-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--accent); margin-top: -6px; }
  .fw-flow-label { margin-top: 20px; font-size: 14px; font-weight: 700; color: var(--accent); }
  .fw-flow-title { margin-top: 6px; font-size: 20px; font-weight: 700; }
  .fw-pillars { display: flex; flex-direction: column; gap: 16px; margin-top: 72px; }
  .fw-pillar { display: flex; flex-wrap: wrap; gap: 32px 72px; padding: clamp(28px, 4.4vw, 64px); }
  .fw-pillar-head { flex: 1 1 320px; min-width: 0; }
  .card p.fw-pillar-n { margin: 0; font-size: clamp(88px, 9vw, 144px); font-weight: 800; letter-spacing: -.05em; line-height: .9; color: var(--accent); }
  .card .fw-tag { margin: 0; }
  .fw-pillar .fw-tag { margin-top: 32px; }
  .fw-pillar-title { margin: 12px 0 0; font-size: clamp(30px, 3vw, 42px); font-weight: 800; letter-spacing: -.03em; line-height: 1.08; }
  .card p.fw-pillar-lead { margin: 14px 0 0; font-size: 19px; line-height: 1.45; color: #D8D3CB; }
  .fw-pillar-body { flex: 999 1 460px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .fw-pillar-body .prose p { margin: 0 0 18px; font-size: 17px; line-height: 1.7; }
  .fw-apply { border-top: 1px solid var(--line); padding-top: 24px; }
  .card p.fw-apply-text { margin: 10px 0 0; font-size: 19px; line-height: 1.5; font-weight: 600; color: var(--paper); }
  .fw-criamos { margin-top: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 48px; border-color: var(--accent); }
  .fw-criamos > div { flex: 1 1 420px; min-width: 0; }
  .fw-criamos .h3 { margin-top: 12px; font-size: clamp(24px, 2.4vw, 30px); }
  .fw-vs-title { max-width: 900px; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.1; }
  .fw-vs-title strong { font-weight: 800; }
  .fw-vs-title em { display: inline; padding: 0; font-style: normal; color: #B4530F; }
  .fw-vs-label { margin: 12px 0 0; font-size: 28px; font-weight: 800; letter-spacing: -.02em; }
  .fw-vs-card { display: flex; flex-direction: column; }
  .fw-vs-card p:not(.fw-tag) { font-size: 16px; line-height: 1.6; }
  .fw-chips { list-style: none; padding: 28px 0 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .fw-chips li { border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; font-size: 14px; }
  .fw-vs-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px; margin-top: 24px; }
  .fw-vs-note p { margin: 0; font-size: 17px; }
  .fw-vs-note strong { color: var(--ink); }
  .t-light .fw-link-ink { color: #B4530F; margin-top: 0; }
  .fw-contrast { padding: clamp(28px, 3.6vw, 48px); }
  .fw-bad { background: var(--warm); }
  .fw-bad .fw-tag { color: #8A857D; }
  .fw-bad .fw-vs-label, .fw-bad li span { color: var(--paper-muted); }
  .fw-good { border-color: var(--accent); }
  .fw-good .fw-tag { color: var(--accent); }
  .fw-list { list-style: none; padding: 0; margin: 28px 0 0; }
  .fw-list li { display: flex; gap: 14px; align-items: flex-start; border-top: 1px solid var(--line); padding: 16px 0; font-size: 16px; line-height: 1.55; }
  .fw-list svg { flex: none; margin-top: 3px; }
  .fw-bad svg { color: #8A857D; }
  .fw-good svg { color: var(--accent); }
  .fw-quote { margin: 0; }
  .fw-quote p:first-child { margin: 0; max-width: 1000px; font-size: clamp(30px, 4.2vw, 62px); font-weight: 800; letter-spacing: -.035em; line-height: 1.08; }
  .fw-quote .fw-cite { margin-top: 32px; font-size: 16px; font-weight: 600; }
  .fw-seg { display: flex; flex-direction: column; gap: 40px; }
  .fw-seg p { font-size: 15px; line-height: 1.55; }
  .fw-seg a { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .fw-rel { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-card); overflow: hidden; text-decoration: none; color: inherit; transition: border-color .2s ease; }
  .fw-rel:hover { border-color: var(--accent); }
  .fw-rel img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .fw-rel-body { padding: 28px 32px 32px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .fw-rel-title { font-size: 24px; font-weight: 700; letter-spacing: -.01em; }
  .fw-rel-desc { font-size: 15px; line-height: 1.55; flex: 1; }
  .fw-rel-link { margin-top: 12px; font-size: 15px; font-weight: 700; color: var(--accent); }
  .fw-cta { border-radius: var(--r-big); padding: clamp(32px, 6vw, 88px); text-align: center; }
  .fw-cta .eyebrow { justify-content: center; color: #B4530F; }
  .fw-cta .h2 { max-width: 860px; margin-inline: auto; font-size: clamp(32px, 4.4vw, 64px); }
  .fw-cta .lead { margin-inline: auto; }
  .fw-cta .btns { justify-content: center; }
  @media (max-width: 600px) { .fw-rel-body { padding: 24px; } .fw-hero-img img { min-height: 0; } }
</style>

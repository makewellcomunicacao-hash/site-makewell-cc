---
// Home redesenhada (artboard Main). Texto 100% do site atual, vindo de src/content/home.ts.
// Ordem: hero → faixa de temas → logos → vídeo → público (BR) / por que (intl) → FishWell → serviços →
// números + cases → depoimentos → quem lidera → FAQ → CTA. Campos de conteúdo com HTML usam set:html.
import Page from '../layouts/Page.astro';
import VideoModal from '../components/VideoModal.astro';
import content from '../content/home';
import { path, type Lang, type PageKey } from '../lib/site';
import { logoSize } from '../lib/logos';

interface Props { page: { htmlAttrs: string; head: string; body: string }; key: PageKey; lang: Lang }
const { page, key, lang } = Astro.props;
const c: any = content[lang];
const lead = (l: { lead: string | null }) => (l.lead ? `fbq('track','Lead',{content_name:'${l.lead}'})` : undefined);
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const pad = (i: number) => String(i + 1).padStart(2, '0');
const play = '<svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="#080808"/></svg>';
const playSm = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="#F4F1EC"/></svg>';
---
<Page page={page} key={key} lang={lang}>
<div class="hm">

  <!-- HERO -->
  <section class="t-warm hm-hero" aria-label={c.heroAria}>
    <div class="wrap">
      <div class="hm-hero-grid">
        <div class="hm-hero-main">
          <p class="eyebrow dot hm-pill">{c.pill}</p>
          <h1 class="h1 hm-h1" set:html={c.h1} />
          <p class="lead hm-hero-p" set:html={c.heroP} />
          <div class="btns">
            <a class="btn btn-primary" href={c.cta1.href} {...ext(c.cta1.href)} onclick={lead(c.cta1)} set:html={c.cta1.text} />
            <a class="btn btn-ghost" href={c.cta2.href} set:html={c.cta2.text} />
          </div>
        </div>
        <div class="hm-hero-side" role="region" aria-label={c.cardAria}>
          <p class="hm-card-head"><span set:html={c.cardTitle} /><span set:html={c.cardSub} /></p>
          {c.stats.map((s: any) => (
            <div class="hm-stat"><span class="hm-stat-n" set:html={s.v} /><span class="hm-stat-l" set:html={s.l} /></div>
          ))}
        </div>
      </div>
      <ul class="hm-chips" aria-label={c.tagsAria}>
        {c.tags.map((t: string) => <li set:html={t} />)}
      </ul>
    </div>
  </section>

  <!-- FAIXA DE TEMAS (antigo ticker) -->
  <div class="t-warm2 hm-ticker">
    <div class="hm-track">
      <ul>{c.ticker.map((t: string) => <li set:html={t} />)}{[0, 1].map(() => c.ticker.map((t: string) => <li aria-hidden="true" set:html={t} />))}</ul>
      <ul aria-hidden="true">{[0, 1, 2].map(() => c.ticker.map((t: string) => <li set:html={t} />))}</ul>
    </div>
  </div>

  <!-- LOGOS -->
  <section class="t-light hm-logos" aria-label={c.clients.aria}>
    <div class="wrap">
      <p class="eyebrow" set:html={c.clients.label} />
      <div class="grid hm-logo-grid">
        {c.clients.logos.map((l: any) => { const z = logoSize(l.src); return <div class="tile"><img src={z.src} alt={l.alt} loading="lazy" style={z.style} /></div>; })}
      </div>
    </div>
  </section>

  <!-- VÍDEO INSTITUCIONAL -->
  <section class="t-warm sec hm-video" id={c.video.id} aria-labelledby="inst-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.video.label} />
      <h2 class="h2" id="inst-title" set:html={c.video.title} />
      <p class="lead" set:html={c.video.sub} />
      <button type="button" class="video-poster hm-poster" data-yt="A28k_Yxm9cc" data-yt-params={c.ui.yt || undefined} aria-label={c.video.play}>
        <img src="/images/escritorio-sala.webp" alt={c.ui.poster} loading="lazy" />
        <span class="play" set:html={play} />
        <span class="hm-poster-label" set:html={c.video.duration} />
      </button>
      <div class="grid hm-photos">
        <img class="photo" src="/images/escritorio-estudio.webp" alt={c.ui.photos[0]} loading="lazy" />
        <img class="photo" src="/images/escritorio-campanhas.webp" alt={c.ui.photos[1]} loading="lazy" />
        <img class="photo" src="/images/escritorio-estante.webp" alt={c.ui.photos[2]} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- PARA QUEM (BR) / POR QUE A MAKEWELL (intl) -->
  <section class="t-light sec hm-seg" id={c.seg.id} aria-labelledby="seg-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.seg.tag} />
      <h2 class="h2" id="seg-title" set:html={c.seg.h2} />
      <p class="lead" set:html={c.seg.sub} />
      <div class:list={['grid hm-seg-grid', c.seg.items.length > 3 ? 'hm-5' : 'hm-3']}>
        {c.seg.items.map((it: any, i: number) => (
          <article class="card">
            {it.num ? <span class="hm-num" set:html={it.num} /> : <span class="hm-num" aria-hidden="true">{pad(i)}</span>}
            <h3 class="h3" set:html={it.title} />
            <p set:html={it.desc} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MÉTODO FISHWELL -->
  <section class="t-warm2 sec hm-fish" id={c.method.id} aria-labelledby="method-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.method.tag} />
      <h2 class="h2 hm-fish-h2" id="method-title" set:html={c.method.h2} />
      <p class="lead" set:html={c.method.sub} />
      <ol class="hm-steps">
        {c.method.steps.map((s: any) => (
          <li>
            <span class="hm-step-dot" aria-hidden="true"></span>
            <span class="hm-step-n">{s.n}</span>
            <h3 class="h3" set:html={s.title} />
            <p set:html={s.desc} />
          </li>
        ))}
      </ol>
      <a class="link-arrow" href={path('method', lang)} set:html={c.method.link} />
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="t-light sec hm-svc" id={c.services.id} aria-labelledby="services-title" aria-description={c.services.desc}>
    <div class="wrap">
      <p class="eyebrow" set:html={c.services.tag} />
      <h2 class="h2" id="services-title" set:html={c.services.h2} />
      <div class="grid hm-svc-grid">
        {c.services.items.map((s: any) => (
          <article class="card">
            <p class="hm-svc-tag" set:html={s.tag} />
            <h3 class="h3" set:html={s.title} />
            <p set:html={s.desc} />
            <ul class="hm-check" aria-label={s.listAria}>{s.li.map((li: string) => <li set:html={li} />)}</ul>
          </article>
        ))}
      </div>
      <a class="link-arrow" href={path('services', lang)} set:html={c.services.link} />
    </div>
  </section>

  <!-- NÚMEROS + CASES (abertura) -->
  <section class="t-accent sec hm-num-sec" id={c.cases.id} aria-labelledby="cases-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.cases.tag} />
      <h2 class="h2 hm-num-h2" id="cases-title" set:html={c.cases.h2} />
      <div class="grid hm-numbers" role="group" aria-label={c.numbersAria}>
        {c.numbers.map((n: any) => (
          <div class="hm-number"><p class="stat-n" set:html={n.v} /><p set:html={n.d} /></div>
        ))}
      </div>
      <div class="btns">
        <a class="btn btn-primary" href={c.cases.all.href} {...ext(c.cases.all.href)} onclick={lead(c.cases.all)} set:html={c.cases.all.text} />
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="t-warm sec hm-cases" aria-label={c.cases.hl.tag}>
    <div class="wrap">
      <a class="hm-hl" href={path('casaHunter', lang)} aria-label={c.cases.hl.aria}>
        <div class="hm-hl-text">
          <p class="hm-badges"><span class="hm-badge hm-badge-accent" set:html={c.cases.hl.tag} /><span class="hm-badge" set:html={c.cases.hl.reach} /></p>
          <h3 class="hm-hl-title" set:html={c.cases.hl.title} />
          <p class="hm-hl-sub" set:html={c.cases.hl.sub} />
          <span class="hm-hl-cta" set:html={c.cases.hl.cta} />
        </div>
        <div class="hm-hl-stats" aria-hidden="true">
          {c.cases.hl.stats.map((s: any) => <div><span set:html={s.v} /><small set:html={s.l} /></div>)}
        </div>
      </a>

      <div class="grid hm-case-grid">
        {c.cases.cards.map((k: any) => (
          <article class="card hm-case">
            <p class="hm-badges"><span class="hm-badge" set:html={k.sector} /><span class="hm-badge hm-badge-accent" set:html={k.roi} /></p>
            <h3 class="h3 hm-case-title" set:html={k.title} />
            <p class="hm-case-sub" set:html={k.sub} />
            <div class="hm-metrics" role="list" aria-label={k.metricsAria}>
              {k.metrics.map((m: any, i: number) => (
                <div role="listitem"><span class:list={['hm-metric-v', { accent: i === 0 }]} set:html={m.v} /><span class="hm-metric-l" set:html={m.l} /></div>
              ))}
            </div>
            <blockquote class="hm-quote"><p set:html={k.quote} /><cite set:html={k.cite} /></blockquote>
          </article>
        ))}
      </div>

      <div class="hm-next">
        <div>
          <p class="eyebrow" set:html={c.cases.nextTag} />
          <p class="hm-next-text" set:html={c.cases.nextText} />
        </div>
        <a class="btn btn-primary" href={c.cases.cta.href} {...ext(c.cases.cta.href)} onclick={lead(c.cases.cta)} set:html={c.cases.cta.text} />
      </div>
      <a class="link-arrow" href={path('cases', lang)} set:html={c.cases.link} />
    </div>
  </section>

  <!-- DEPOIMENTOS -->
  <section class="t-light sec hm-depo" aria-labelledby="depo-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.depo.label} />
      <h2 class="h2" id="depo-title" set:html={c.depo.h2} />
      {c.depo.note && <p class="hm-note" set:html={c.depo.note} />}
      <div class="reels hm-reels">
        {c.depo.reels.map((r: any) => (
          <button type="button" class="reel" data-yt={r.id} data-vertical>
            <span class="thumb">
              <img src={`https://img.youtube.com/vi/${r.id}/hqdefault.jpg`} alt={r.name} width="480" height="360" loading="lazy" />
              <span class="play sm" set:html={playSm} />
            </span>
            <span class="hm-reel-q" set:html={r.quote} />
            <span class="hm-reel-name" set:html={r.name} />
            <span class="hm-reel-role" set:html={r.role} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- QUEM LIDERA -->
  <section class="t-warm sec hm-about" id={c.about.id} aria-labelledby="about-title">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow" set:html={c.about.tag} />
        <h2 class="h2" id="about-title" set:html={c.about.h2} />
        <p class="lead" set:html={c.about.p} />
        <blockquote class="hm-manifesto"><p set:html={c.about.quote} /></blockquote>
        <a class="link-arrow" href={path('about', lang)} set:html={c.about.link} />
      </div>
      <div class="side">
        {c.about.team.map((t: any) => (
          <div class="hm-team">
            <img src={t.img} alt={t.alt} width="110" height="110" loading="lazy" />
            <div><p class="hm-team-name" set:html={t.name} /><p class="hm-team-role" set:html={t.role} /></div>
          </div>
        ))}
        <div class="hm-about-stats" role="group" aria-label={c.about.statsAria}>
          {c.about.stats.map((s: any) => <div><span set:html={s.v} /><small set:html={s.l} /></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="t-warm2 sec line-top hm-faq" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="side">
        <p class="eyebrow" set:html={c.faq.tag} />
        <h2 class="h2" id="faq-title" set:html={c.faq.h2} />
      </div>
      <div class="main faq" itemscope itemtype="https://schema.org/FAQPage">
        {c.faq.items.map((f: any) => (
          <details itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary><span itemprop="name" set:html={f.q} /></summary>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><p itemprop="text" set:html={f.a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="t-light sec hm-cta" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="hm-cta-card">
        <p class="eyebrow dot" set:html={c.cta.pill} />
        <h2 class="h2" id="cta-title" set:html={c.cta.h2} />
        <p class="lead" set:html={c.cta.p} />
        <div class="btns">
          <a class="btn btn-primary" href={c.cta.btn1.href} {...ext(c.cta.btn1.href)} onclick={lead(c.cta.btn1)} set:html={c.cta.btn1.text} />
          <a class="btn btn-ghost" href={c.cta.btn2.href} {...ext(c.cta.btn2.href)} onclick={lead(c.cta.btn2)} set:html={c.cta.btn2.text} />
        </div>
      </div>
    </div>
  </section>

</div>
<VideoModal closeLabel={c.ui.close} slot="after" />
</Page>

<style is:inline>
  .hm { --ink-accent: #A84B0C; }
  .hm .gold { color: var(--accent); }
  .hm .t-light .gold, .hm .t-light .eyebrow, .hm .t-light .link-arrow, .hm .t-light .hm-num { color: var(--ink-accent); }
  .hm .t-light .eyebrow.dot::before { background: var(--accent); }
  .hm .t-accent .gold { color: inherit; }
  .hm .h1, .hm .h2, .hm .h3, .hm-hl-title, .hm-next-text, .hm-manifesto p { text-wrap: balance; }

  /* hero */
  .hm-hero { padding-block: clamp(72px, 9vw, 112px) clamp(56px, 7vw, 88px); }
  .hm-hero-grid { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 48px 64px; }
  .hm-hero-main { flex: 999 1 560px; min-width: 0; }
  .hm-hero-side { flex: 1 1 340px; min-width: 0; }
  .hm-pill { color: var(--muted); }
  @media (max-width: 520px) { .hm-pill { font-size: 12px; letter-spacing: .1em; } }
  .hm-h1 { font-size: clamp(40px, 5.6vw, 84px); }
  .hm-hero-p strong { color: var(--paper); }
  .hm-card-head { display: flex; justify-content: space-between; gap: 16px; margin: 0 0 4px; padding-bottom: 14px; font-size: 12px; font-weight: 600; letter-spacing: .1em; white-space: nowrap; text-transform: uppercase; color: var(--muted); }
  .hm-card-head span + span { color: var(--paper); }
  @media (max-width: 400px) { .hm-card-head { white-space: normal; letter-spacing: .06em; gap: 10px; } .hm-card-head span + span { text-align: right; } }
  .hm-stat { border-top: 1px solid var(--line); padding: 22px 0; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .hm-stat-n { white-space: nowrap; font-size: clamp(40px, 4vw, 56px); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .hm-stat:nth-of-type(odd) .hm-stat-n { color: var(--accent); }
  .hm-stat-l { font-size: 14px; color: var(--muted); text-align: right; max-width: 160px; line-height: 1.4; }
  .hm-chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 64px 0 0; padding: 0; list-style: none; }
  .hm-chips li { border: 1px solid var(--line); border-radius: 999px; padding: 10px 18px; font-size: 14px; color: #D8D3CB; }
  @media (max-width: 520px) { .hm-chips { gap: 8px; margin-top: 48px; } .hm-chips li { padding: 8px 13px; font-size: 13px; } }
  /* faixa de temas: uma linha só. Desktop: fonte menor e centralizada; abaixo de 1100px vira letreiro contínuo */
  .hm-ticker { border-block: 1px solid var(--line); overflow: hidden; }
  .hm-track { display: flex; justify-content: center; }
  .hm-ticker ul { display: flex; flex-wrap: nowrap; margin: 0; padding: 18px 0; list-style: none; white-space: nowrap; }

  .hm-ticker li { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .hm-ticker li::after { content: "·"; margin: 0 12px; color: var(--accent); }
  /* letreiro contínuo em todas as larguras (movimento pedido pelo usuário) */
  .hm-track { justify-content: flex-start; width: max-content; animation: hm-scroll 70s linear infinite; }
  .hm-ticker:hover .hm-track { animation-play-state: paused; }

  @keyframes hm-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .hm-track { animation: none; } .hm-ticker { overflow-x: auto; } }

  /* logos */
  .hm-logos { padding-block: 48px; border-bottom: 1px solid var(--line); }
  .hm-logo-grid { gap: 12px; margin-top: 24px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (min-width: 640px) { .hm-logo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .hm-logo-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .hm-logo-grid img { filter: grayscale(1); opacity: .85; transition: filter .2s, opacity .2s; }
  .hm-logo-grid .tile:hover img { filter: none; opacity: 1; }
  @media (max-width: 639px) { .hm-logo-grid { gap: 8px; } .hm-logo-grid .tile { min-height: 72px; } .hm-logo-grid img { max-width: 84%; } }

  /* vídeo */
  .hm-poster { margin-top: 48px; }
  .hm-poster img { filter: brightness(.7); }
  .hm-poster .play { width: 104px; height: 104px; }
  .hm-poster-label { position: absolute; left: 24px; bottom: 24px; background: rgba(8,8,8,.8); color: var(--paper); padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 600; }
  .hm-photos { margin-top: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hm-photos .photo { aspect-ratio: 4/3; height: 100%; border-radius: var(--r-card); }
  @media (max-width: 639px) {
    .hm-poster { margin-top: 36px; border-radius: var(--r-card); }
    .hm-poster .play { width: 64px; height: 64px; }
    .hm-poster .play svg { width: 24px; height: 24px; }
    .hm-poster-label { left: 12px; bottom: 12px; padding: 7px 12px; font-size: 12px; }
    .hm-photos { gap: 8px; margin-top: 8px; }
    .hm-photos .photo { aspect-ratio: 3/4; border-radius: 14px; }
  }

  /* público / por que */
  .hm-seg-grid { margin-top: 56px; }
  .hm-seg .card { display: flex; flex-direction: column; gap: 14px; }
  .hm-seg .card p { margin: 0; font-size: 15px; line-height: 1.6; }
  /* 5 nichos: 5 numa linha (desktop), 3 + 2 (tablet), empilhados (celular). 3 itens (intl): 3 ou empilhados */
  .hm-seg-grid.hm-5 { gap: 12px; }
  .hm-seg-grid.hm-5 .card { padding: 24px 20px; gap: 10px; }
  .hm-seg-grid.hm-5 .card p { font-size: 14px; line-height: 1.55; }
  .hm-seg-grid.hm-5 .h3 { font-size: 18px; }
  .hm-seg-grid.hm-5 .hm-num { margin-bottom: 8px; }
  @media (min-width: 640px) {
    .hm-seg-grid.hm-5 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .hm-seg-grid.hm-5 > * { grid-column: span 2; }
    .hm-seg-grid.hm-5 > :nth-child(n+4) { grid-column: span 3; }
  }
  @media (min-width: 1100px) { .hm-seg-grid.hm-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); } .hm-seg-grid.hm-5 > * { grid-column: auto; } }
  .hm-seg-grid.hm-3 { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .hm-seg-grid.hm-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .hm-num { font-size: 14px; font-weight: 700; color: var(--accent); margin-bottom: 18px; }
  .hm-seg h3 span { color: var(--ink-accent); }

  /* FishWell */
  .hm-fish-h2 { font-size: clamp(40px, 5vw, 72px); }
  .hm-steps { list-style: none; margin: 72px 0 0; padding: 0; display: grid; gap: 40px 24px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .hm-steps { grid-template-columns: repeat(6, minmax(0, 1fr)); } .hm-steps li { grid-column: span 2; } .hm-steps li:nth-child(n+4) { grid-column: span 3; } }
  @media (min-width: 1100px) { .hm-steps { grid-template-columns: repeat(5, minmax(0, 1fr)); } .hm-steps li, .hm-steps li:nth-child(n+4) { grid-column: auto; } }
  @media (max-width: 639px) {
    .hm-steps { margin-top: 48px; gap: 0; }
    .hm-steps li { display: grid; grid-template-columns: 64px minmax(0, 1fr); column-gap: 8px; padding-bottom: 24px; }
    .hm-steps .hm-step-dot { grid-column: 1 / -1; }
    .hm-steps .hm-step-n { grid-row: 2 / span 2; margin-top: 20px; font-size: 40px; }
    .hm-steps h3 { grid-column: 2; margin-top: 22px; font-size: 20px; }
    .hm-steps p { grid-column: 2; }
  }
  .hm-steps li { border-top: 1px solid var(--line); }
  .hm-step-dot { display: block; width: 11px; height: 11px; border-radius: 50%; background: var(--accent); margin-top: -6px; }

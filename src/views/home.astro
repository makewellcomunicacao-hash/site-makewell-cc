---
// Home redesenhada (artboard Main). Texto 100% do site atual, vindo de src/content/home.ts.
// Ordem: hero → faixa de temas → logos → vídeo → público (BR) / por que (intl) → FishWell → serviços →
// números + cases → depoimentos → quem lidera → FAQ → CTA. Campos de conteúdo com HTML usam set:html.
import Page from '../layouts/Page.astro';
import VideoModal from '../components/VideoModal.astro';
import VideoCover from '../components/VideoCover.astro';
import content from '../content/home';
import { path, type Lang, type PageKey } from '../lib/site';
import { logoSize } from '../lib/logos';

interface Props { page: { htmlAttrs: string; head: string; body: string }; key: PageKey; lang: Lang }
const { page, key, lang } = Astro.props;
const c: any = content[lang];
const lead = (l: { lead: string | null }) => (l.lead ? `fbq('track','Lead',{content_name:'${l.lead}'})` : undefined);
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const pad = (i: number) => String(i + 1).padStart(2, '0');
const play = '<svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="#080808"/></svg>';
const playSm = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="#F4F1EC"/></svg>';
---
<Page page={page} key={key} lang={lang}>
<div class="hm">

  <!-- HERO -->
  <section class="t-warm hm-hero" aria-label={c.heroAria}>
    <!-- fundo: gráfico de resultado (barras crescendo, ROI subindo, CAC caindo); decorativo -->
    <div class="hm-chart" aria-hidden="true">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" focusable="false">
        <defs>
          <linearGradient id="hmUp" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#F5A623"/><stop offset="1" stop-color="#F07820"/></linearGradient>
          <linearGradient id="hmArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#F07820" stop-opacity=".28"/><stop offset="1" stop-color="#F07820" stop-opacity="0"/></linearGradient>
          <linearGradient id="hmBar" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#F5A623" stop-opacity=".4"/><stop offset="1" stop-color="#F07820" stop-opacity="0"/></linearGradient>
          <filter id="hmGlow" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="6"/></filter>
        </defs>
        <g class="grid"><line x1="0" x2="1440" y1="100" y2="100"/><line x1="0" x2="1440" y1="200" y2="200"/><line x1="0" x2="1440" y1="300" y2="300"/><line x1="0" x2="1440" y1="400" y2="400"/><line x1="0" x2="1440" y1="500" y2="500"/><line x1="0" x2="1440" y1="600" y2="600"/><line x1="0" x2="1440" y1="700" y2="700"/><line x1="0" x2="1440" y1="800" y2="800"/></g>
        <g class="bars" fill="url(#hmBar)"><rect class="bar" style="--i:0" x="24" y="840" width="26" height="60" rx="3"/><rect class="bar" style="--i:1" x="84" y="799" width="26" height="101" rx="3"/><rect class="bar" style="--i:2" x="144" y="828" width="26" height="72" rx="3"/><rect class="bar" style="--i:3" x="204" y="767" width="26" height="133" rx="3"/><rect class="bar" style="--i:4" x="264" y="786" width="26" height="114" rx="3"/><rect class="bar" style="--i:5" x="324" y="805" width="26" height="95" rx="3"/><rect class="bar" style="--i:6" x="384" y="724" width="26" height="176" rx="3"/><rect class="bar" style="--i:7" x="444" y="743" width="26" height="157" rx="3"/><rect class="bar" style="--i:8" x="504" y="692" width="26" height="208" rx="3"/><rect class="bar" style="--i:9" x="564" y="741" width="26" height="159" rx="3"/><rect class="bar" style="--i:10" x="624" y="650" width="26" height="250" rx="3"/><rect class="bar" style="--i:11" x="684" y="679" width="26" height="221" rx="3"/><rect class="bar" style="--i:12" x="744" y="618" width="26" height="282" rx="3"/><rect class="bar" style="--i:13" x="804" y="667" width="26" height="233" rx="3"/><rect class="bar" style="--i:14" x="864" y="566" width="26" height="334" rx="3"/><rect class="bar" style="--i:15" x="924" y="605" width="26" height="295" rx="3"/><rect class="bar" style="--i:16" x="984" y="554" width="26" height="346" rx="3"/><rect class="bar" style="--i:17" x="1044" y="503" width="26" height="397" rx="3"/><rect class="bar" style="--i:18" x="1104" y="542" width="26" height="358" rx="3"/><rect class="bar" style="--i:19" x="1164" y="461" width="26" height="439" rx="3"/><rect class="bar" style="--i:20" x="1224" y="480" width="26" height="420" rx="3"/><rect class="bar" style="--i:21" x="1284" y="409" width="26" height="491" rx="3"/><rect class="bar" style="--i:22" x="1344" y="418" width="26" height="482" rx="3"/><rect class="bar" style="--i:23" x="1404" y="357" width="26" height="543" rx="3"/></g>
        <path class="area" d="M0,900 L0,780 L120,752 L240,716 L360,730 L480,664 L600,634 L720,572 L840,590 L960,486 L1080,446 L1200,350 L1320,270 L1440,170 L1440,900 Z" fill="url(#hmArea)"/>
        <polyline class="ln dn" points="0,330 160,356 320,348 480,402 640,420 800,470 960,490 1120,548 1280,566 1440,618" pathLength="1"/>
        <polyline class="ln up glow" points="0,780 120,752 240,716 360,730 480,664 600,634 720,572 840,590 960,486 1080,446 1200,350 1320,270 1440,170" pathLength="1" filter="url(#hmGlow)"/>
        <polyline class="ln up" points="0,780 120,752 240,716 360,730 480,664 600,634 720,572 840,590 960,486 1080,446 1200,350 1320,270 1440,170" pathLength="1"/>
        <polyline class="comet" points="0,780 120,752 240,716 360,730 480,664 600,634 720,572 840,590 960,486 1080,446 1200,350 1320,270 1440,170" pathLength="1"/>
        <g class="dots"><circle class="dot" style="--i:4" cx="480" cy="664" r="5"/><circle class="dot" style="--i:6" cx="720" cy="572" r="5"/><circle class="dot" style="--i:8" cx="960" cy="486" r="5"/><circle class="dot" style="--i:10" cx="1200" cy="350" r="5"/><circle class="dot" style="--i:12" cx="1440" cy="170" r="5"/></g>
      </svg>
    </div>
    <div class="wrap">
      <div class="hm-hero-grid">
        <div class="hm-hero-main">
          <p class="eyebrow dot hm-pill">{c.pill}</p>
          <h1 class="h1 hm-h1" set:html={c.h1} />
          <p class="lead hm-hero-p" set:html={c.heroP} />
          <div class="btns">
            <a class="btn btn-primary" href={c.cta1.href} {...ext(c.cta1.href)} onclick={lead(c.cta1)} set:html={c.cta1.text} />
            <a class="btn btn-ghost" href={c.cta2.href} set:html={c.cta2.text} />
          </div>
        </div>
        <div class="hm-hero-side glass" role="region" aria-label={c.cardAria}>
          <p class="hm-card-head"><span set:html={c.cardTitle} /><span set:html={c.cardSub} /></p>
          {c.stats.map((s: any) => (
            <div class="hm-stat"><span class="hm-stat-n" set:html={s.v} /><span class="hm-stat-l" set:html={s.l} /></div>
          ))}
        </div>
      </div>
      <ul class="hm-chips" aria-label={c.tagsAria}>
        {c.tags.map((t: string) => <li set:html={t} />)}
      </ul>
    </div>
  </section>

  <!-- FAIXA DE TEMAS (antigo ticker) -->
  <div class="t-warm2 hm-ticker">
    <div class="hm-track">
      <ul>{c.ticker.map((t: string) => <li set:html={t} />)}{[0, 1].map(() => c.ticker.map((t: string) => <li aria-hidden="true" set:html={t} />))}</ul>
      <ul aria-hidden="true">{[0, 1, 2].map(() => c.ticker.map((t: string) => <li set:html={t} />))}</ul>
    </div>
  </div>

  <!-- LOGOS -->
  <section class="t-light hm-logos" aria-label={c.clients.aria}>
    <div class="wrap">
      <p class="eyebrow" set:html={c.clients.label} />
      <div class="grid hm-logo-grid">
        {c.clients.logos.map((l: any) => { const z = logoSize(l.src); return <div class="tile"><img src={z.src} alt={l.alt} loading="lazy" style={z.style} /></div>; })}
      </div>
    </div>
  </section>

  <!-- VÍDEO INSTITUCIONAL -->
  <section class="t-warm sec hm-video" id={c.video.id} aria-labelledby="inst-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.video.label} />
      <h2 class="h2" id="inst-title" set:html={c.video.title} />
      <p class="lead" set:html={c.video.sub} />
      <VideoCover lang={lang} params={c.ui.yt} class="hm-poster" />
      <div class="grid hm-photos">
        <img class="photo" src="/images/escritorio-estudio.webp" srcset="/images/escritorio-estudio-480.webp 480w, /images/escritorio-estudio.webp 1210w" sizes="(max-width: 600px) 33vw, 420px" alt={c.ui.photos[0]} loading="lazy" />
        <img class="photo" src="/images/escritorio-campanhas.webp" srcset="/images/escritorio-campanhas-480.webp 480w, /images/escritorio-campanhas.webp 1210w" sizes="(max-width: 600px) 33vw, 420px" alt={c.ui.photos[1]} loading="lazy" />
        <img class="photo" src="/images/escritorio-estante.webp" srcset="/images/escritorio-estante-480.webp 480w, /images/escritorio-estante.webp 1210w" sizes="(max-width: 600px) 33vw, 420px" alt={c.ui.photos[2]} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- PARA QUEM (5 nichos) e POR QUE A MAKEWELL (3 diferenciais): as mesmas duas seções nas 4 línguas -->
  {[c.seg, c.why].map((s: any, k: number) => (
  <section class:list={['t-light sec hm-seg', k && 'line-top hm-why']} id={s.id} aria-labelledby={`${s.id}-title`}>
    <div class="wrap">
      <p class="eyebrow" set:html={s.tag} />
      <h2 class="h2" id={`${s.id}-title`} set:html={s.h2} />
      <p class="lead" set:html={s.sub} />
      <div class:list={['hscroll hm-seg-grid', k && 'slide-in']}>
        {s.items.map((it: any, i: number) => (
          <article class="card">
            {it.num ? <span class="hm-num" set:html={it.num} /> : <span class="hm-num" aria-hidden="true">{pad(i)}</span>}
            <h3 class="h3" set:html={it.title} />
            <p set:html={it.desc} />
          </article>
        ))}
      </div>
    </div>
  </section>
  ))}

  <!-- MÉTODO FISHWELL -->
  <section class="t-warm2 sec hm-fish" id={c.method.id} aria-labelledby="method-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.method.tag} />
      <h2 class="h2 hm-fish-h2" id="method-title" set:html={c.method.h2} />
      <p class="lead" set:html={c.method.sub} />
      <ol class="hm-steps">
        {c.method.steps.map((s: any) => (
          <li>
            <span class="hm-step-dot" aria-hidden="true"></span>
            <span class="hm-step-n" aria-hidden="true">{s.n}</span>
            <h3 class="h3" set:html={s.title} />
            <p set:html={s.desc} />
          </li>
        ))}
      </ol>
      <a class="link-arrow" href={path('method', lang)} set:html={c.method.link} />
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="t-light sec hm-svc" id={c.services.id} aria-labelledby="services-title" aria-description={c.services.desc}>
    <div class="wrap">
      <p class="eyebrow" set:html={c.services.tag} />
      <h2 class="h2" id="services-title" set:html={c.services.h2} />
      <div class="grid hm-svc-grid">
        {c.services.items.map((s: any) => (
          <article class="card">
            <p class="hm-svc-tag" set:html={s.tag} />
            <h3 class="h3" set:html={s.title} />
            <p set:html={s.desc} />
            <ul class="hm-check" aria-label={s.listAria}>{s.li.map((li: string) => <li set:html={li} />)}</ul>
          </article>
        ))}
      </div>
      <a class="link-arrow" href={path('services', lang)} set:html={c.services.link} />
    </div>
  </section>

  <!-- NÚMEROS + CASES (abertura) -->
  <section class="t-accent sec hm-num-sec" id={c.cases.id} aria-labelledby="cases-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.cases.tag} />
      <h2 class="h2 hm-num-h2" id="cases-title" set:html={c.cases.h2} />
      <div class="grid hm-numbers" role="group" aria-label={c.numbersAria}>
        {c.numbers.map((n: any) => (
          <div class="hm-number"><p class="stat-n" set:html={n.v} /><p set:html={n.d} /></div>
        ))}
      </div>
      <div class="btns">
        <a class="btn btn-primary" href={c.cases.all.href} {...ext(c.cases.all.href)} onclick={lead(c.cases.all)} set:html={c.cases.all.text} />
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="t-warm sec hm-cases" aria-label={c.cases.hl.tag}>
    <div class="wrap">
      <a class="hm-hl" href={path('casaHunter', lang)} aria-label={c.cases.hl.aria}>
        <div class="hm-hl-text">
          <p class="hm-badges"><span class="hm-badge hm-badge-accent" set:html={c.cases.hl.tag} /><span class="hm-badge" set:html={c.cases.hl.reach} /></p>
          <h3 class="hm-hl-title" set:html={c.cases.hl.title} />
          <p class="hm-hl-sub" set:html={c.cases.hl.sub} />
          <span class="hm-hl-cta" set:html={c.cases.hl.cta} />
        </div>
        <div class="hm-hl-stats" aria-hidden="true">
          {c.cases.hl.stats.map((s: any) => <div><span set:html={s.v} /><small set:html={s.l} /></div>)}
        </div>
      </a>

      <div class="grid hm-case-grid">
        {c.cases.cards.map((k: any) => (
          <article class="card hm-case">
            <p class="hm-badges"><span class="hm-badge" set:html={k.sector} /><span class="hm-badge hm-badge-accent" set:html={k.roi} /></p>
            <h3 class="h3 hm-case-title" set:html={k.title} />
            <p class="hm-case-sub" set:html={k.sub} />
            <div class="hm-metrics" role="list" aria-label={k.metricsAria}>
              {k.metrics.map((m: any, i: number) => (
                <div role="listitem"><span class:list={['hm-metric-v', { accent: i === 0 }]} set:html={m.v} /><span class="hm-metric-l" set:html={m.l} /></div>
              ))}
            </div>
            <blockquote class="hm-quote"><p set:html={k.quote} /><cite set:html={k.cite} /></blockquote>
          </article>
        ))}
      </div>

      <div class="hm-next">
        <div>
          <p class="eyebrow" set:html={c.cases.nextTag} />
          <p class="hm-next-text" set:html={c.cases.nextText} />
        </div>
        <a class="btn btn-primary" href={c.cases.cta.href} {...ext(c.cases.cta.href)} onclick={lead(c.cases.cta)} set:html={c.cases.cta.text} />
      </div>
      <a class="link-arrow" href={path('cases', lang)} set:html={c.cases.link} />
    </div>
  </section>

  <!-- DEPOIMENTOS -->
  <section class="t-light sec hm-depo" aria-labelledby="depo-title">
    <div class="wrap">
      <p class="eyebrow" set:html={c.depo.label} />
      <h2 class="h2" id="depo-title" set:html={c.depo.h2} />
      {c.depo.note && <p class="hm-note" set:html={c.depo.note} />}
      <div class="reels hscroll hm-reels">
        {c.depo.reels.map((r: any) => (
          <button type="button" class="reel" data-yt={r.id} data-vertical>
            <span class="thumb">
              <img src={`/images/depo-${r.id}.webp`} alt={r.name} width="720" height="1280" loading="lazy" />
              <span class="play sm" set:html={playSm} />
            </span>
            <span class="hm-reel-q" set:html={r.quote} />
            <span class="hm-reel-name" set:html={r.name} />
            <span class="hm-reel-role" set:html={r.role} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- QUEM LIDERA -->
  <section class="t-warm sec hm-about" id={c.about.id} aria-labelledby="about-title">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow" set:html={c.about.tag} />
        <h2 class="h2" id="about-title" set:html={c.about.h2} />
        <p class="lead" set:html={c.about.p} />
        <blockquote class="hm-manifesto"><p set:html={c.about.quote} /></blockquote>
        <a class="link-arrow" href={path('about', lang)} set:html={c.about.link} />
      </div>
      <div class="side">
        {c.about.team.map((t: any) => (
          <div class="hm-team">
            <img src={t.img} alt={t.alt} width="110" height="110" loading="lazy" />
            <div><p class="hm-team-name" set:html={t.name} /><p class="hm-team-role" set:html={t.role} /></div>
          </div>
        ))}
        <div class="hm-about-stats" role="group" aria-label={c.about.statsAria}>
          {c.about.stats.map((s: any) => <div><span set:html={s.v} /><small set:html={s.l} /></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="t-warm2 sec line-top hm-faq" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="side">
        <p class="eyebrow" set:html={c.faq.tag} />
        <h2 class="h2" id="faq-title" set:html={c.faq.h2} />
      </div>
      <div class="main faq" itemscope itemtype="https://schema.org/FAQPage">
        {c.faq.items.map((f: any) => (
          <details itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary><span itemprop="name" set:html={f.q} /></summary>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><p itemprop="text" set:html={f.a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="t-light sec hm-cta" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="hm-cta-card">
        <p class="eyebrow dot" set:html={c.cta.pill} />
        <h2 class="h2" id="cta-title" set:html={c.cta.h2} />
        <p class="lead" set:html={c.cta.p} />
        <div class="btns">
          <a class="btn btn-primary" href={c.cta.btn1.href} {...ext(c.cta.btn1.href)} onclick={lead(c.cta.btn1)} set:html={c.cta.btn1.text} />
          <a class="btn btn-ghost" href={c.cta.btn2.href} {...ext(c.cta.btn2.href)} onclick={lead(c.cta.btn2)} set:html={c.cta.btn2.text} />
        </div>
      </div>
    </div>
  </section>

</div>
<VideoModal lang={lang} closeLabel={c.ui.close} slot="after" />
<style is:inline slot="head">
  .hm { --ink-accent: #A84B0C; }
  .hm .gold { color: var(--accent); }
  .hm .t-light .gold, .hm .t-light .eyebrow, .hm .t-light .link-arrow, .hm .t-light .hm-num { color: var(--ink-accent); }
  .hm .t-light .eyebrow.dot::before { background: var(--accent); }
  .hm .t-accent .gold { color: inherit; }
  .hm .h1, .hm .h2, .hm .h3, .hm-hl-title, .hm-next-text, .hm-manifesto p { text-wrap: balance; }

  /* hero */
  /* fundo do hero: gráfico de resultado. Forte à direita (atrás dos números), some à esquerda (título) */
  .hm-chart { position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .9; }
  .hm-chart svg { width: 100%; height: 100%; display: block; }
  .hm-chart::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--warm) 0%, rgba(14,13,11,.92) 30%, rgba(14,13,11,.55) 58%, rgba(14,13,11,.15) 100%), linear-gradient(0deg, var(--warm) 0%, rgba(14,13,11,0) 22%); }
  .hm-chart .grid line { stroke: rgba(244,241,236,.05); stroke-width: 1; }
  .hm-chart .bar { transform-box: fill-box; transform-origin: 50% 100%; animation: hm-bar 1.6s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 45ms + .2s) both, hm-breathe calc(5s + var(--i) * 170ms) ease-in-out calc(2.6s + var(--i) * 90ms) infinite; }
  .hm-chart .ln { fill: none; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: hm-draw 2.4s .5s cubic-bezier(.6,0,.2,1) forwards; }
  .hm-chart .up { stroke: url(#hmUp); stroke-width: 3.5; }
  .hm-chart .glow { stroke-width: 10; opacity: .55; }
  .hm-chart .dn { stroke: rgba(244,241,236,.32); stroke-width: 2; stroke-dasharray: 1; animation-duration: 3s; animation-delay: .9s; }
  .hm-chart .area { opacity: 0; animation: hm-fade 1.6s 1.6s ease forwards; }
  .hm-chart .comet { fill: none; stroke: #FFE2B8; stroke-width: 4; stroke-linecap: round; stroke-dasharray: .05 .95; stroke-dashoffset: .05; opacity: 0; filter: drop-shadow(0 0 6px #F5A623); animation: hm-fade .6s 2.9s forwards, hm-comet 5.5s 2.9s linear infinite; }
  .hm-chart .dot { fill: #F5A623; stroke: var(--warm); stroke-width: 3; opacity: 0; animation: hm-fade .5s ease forwards; animation-delay: calc(1.2s + var(--i) * .16s); }
  @keyframes hm-bar { from { transform: scaleY(0); } }
  /* depois de crescer, as barras "respiram" (cada uma no seu tempo) para o gráfico seguir vivo */
  @keyframes hm-breathe { 50% { transform: scaleY(.93); } }
  @keyframes hm-draw { to { stroke-dashoffset: 0; } }

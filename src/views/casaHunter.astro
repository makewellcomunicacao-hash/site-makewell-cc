---
// Case Casa Hunter / Casa dos Raros (artboard CaseCasaHunter): hero escuro, história em cards claros
// (desafio, solução, o que fizemos), números em laranja, resultados claros, depoimento + filosofia no escuro, CTA claro.
import Page from '../layouts/Page.astro';
import VideoModal from '../components/VideoModal.astro';
import { path } from '../lib/site';
import C from '../content/casaHunter';

const { page, key, lang } = Astro.props;
const c = C[lang];
const pad = (i) => String(i + 1).padStart(2, '0');
const YT = 'JRrnKGNk-UE';
---
<Page page={page} key={key} lang={lang}>
  <article>
    <header class="t-warm ch-hero">
      <div class="wrap">
        <nav aria-label={c.crumbLabel} class="ch-crumb">
          <a href={path('cases', lang)}>{c.crumbCases}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Casa Hunter</span>
        </nav>
        <div class="split ch-hero-split">
          <div class="main">
            <p class="eyebrow dot ch-kicker">{c.kicker}</p>
            <h1 class="h1 ch-h1">{c.h1[0]} <em>{c.h1[1]}</em></h1>
            <p class="lead">{c.lead}</p>
          </div>
          <div class="side ch-logos">
            <div class="ch-logo"><img src="/images/logo-casa-hunter.webp" alt="Casa Hunter" width="1714" height="1072" /></div>
            <div class="ch-logo"><img src="/images/logo-casa-dos-raros.webp" alt="Casa dos Raros" width="2838" height="2246" /></div>
          </div>
        </div>
        <dl class="ch-facts">
          {c.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
    </header>

    <div class="t-light sec ch-story">
      <div class="wrap ch-stack">
        <section id={c.ids.challenge} class="card ch-card">
          <div class="ch-card-head"><span class="num">01</span><h2>{c.challenge.label}</h2></div>
          <div class="ch-card-body prose">
            <h3 class="ch-title" set:html={c.challenge.title} />
            {c.challenge.ps.map((p) => <p set:html={p} />)}
          </div>
        </section>

        <section id={c.ids.solution} class="card ch-card">
          <div class="ch-card-head"><span class="num">02</span><h2>{c.solution.label}</h2></div>
          <div class="ch-card-body prose">
            <h3 class="ch-title">{c.solution.title}</h3>
            <p set:html={c.solution.p} />
            <ul class="ch-pills">{c.solution.pillars.map((p) => <li>{p}</li>)}</ul>
          </div>
        </section>

        <section class="card ch-card">
          <div class="ch-card-head"><span class="num">03</span><h2>{c.did.label}</h2></div>
          <div class="ch-card-body">
            {c.did.items.map((d, i) => (
              <div class="ch-did prose">
                <h3><span class="num">{pad(i)}</span>{d.title}</h3>
                {d.ps.map((p) => <p set:html={p} />)}
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <section id={c.ids.results} class="t-accent sec ch-num">
      <div class="wrap">
        <h2 class="h2" set:html={c.results.title} />
        <p class="lead">{c.results.p}</p>
        <div class="ch-stats" role="list">
          {c.results.stats.map((s) => <div role="listitem"><p class="stat-n">{s.n}</p><p class="ch-stat-l">{s.l}</p></div>)}
        </div>
      </div>
    </section>

    <div class="t-light sec ch-res">
      <ul class="wrap grid ch-res-list">
        {c.results.list.map((r, i) => (
          <li class="card"><span class="num">{pad(i)}</span><div><h3 class="h3">{r.t}</h3><p>{r.d}</p></div></li>
        ))}
      </ul>
    </div>

    <section id={c.ids.philosophy} class="t-warm sec">
      <div class="wrap ch-quote">
        <button type="button" class="ch-video" data-yt={YT} data-vertical data-yt-params={c.testimonial.ytParams || undefined} aria-label={c.testimonial.watch}>
          <img src={`/images/depo-${YT}.webp?v=2`} alt="Paola Massari, Casa Hunter" width="720" height="900" loading="lazy" />
          <span class="play" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="#080808"><polygon points="8,5 19,12 8,19" /></svg></span>
        </button>
        <div class="ch-quote-text">
          <figure>
            <p class="eyebrow">{c.testimonial.eyebrow}</p>
            <blockquote class="ch-bq">{c.testimonial.quote}</blockquote>
            <figcaption><span class="ch-name">Paola Massari</span><span class="muted">Marketing · Casa Hunter</span></figcaption>
            {c.testimonial.note && <p class="muted ch-note">{c.testimonial.note}</p>}
          </figure>
          <div class="ch-phil line-top">
            <h2 class="ch-phil-h">{c.philosophy.h2}</h2>
            <blockquote class="ch-tagline">{c.philosophy.quote}</blockquote>
            <div class="prose">{c.philosophy.ps.map((p) => <p>{p}</p>)}</div>
            <div class="ch-rel line-top">
              <h3 class="h3">{c.philosophy.relH3}</h3>
              <p class="muted">{c.philosophy.relP}</p>
              <a class="link-arrow" href={path('howWeCreate', lang)}>{c.philosophy.relLink}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="diagnostico" class="t-light sec">
      <div class="wrap">
        <div class="card ch-cta">
          <p class="eyebrow">{c.cta.eyebrow}</p>
          <h2 class="h2">{c.cta.h2}</h2>
          <p class="lead">{c.cta.p}</p>
          <div class="btns">
            <a class="btn btn-primary" href={c.cta.href} target="_blank" rel="noopener noreferrer" onclick={`fbq('track','Lead',{content_name:'${c.cta.lead}'})`}>{c.cta.btn}</a>
          </div>
        </div>
      </div>
    </section>
  </article>
  <VideoModal lang={lang} closeLabel={c.close} slot="after" />
<style is:inline slot="head">
  .ch-hero { padding-block: 56px 88px; }
  .ch-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
  .ch-crumb a { color: var(--muted); text-decoration: none; padding-block: 12px; }
  .ch-crumb a:hover { color: var(--paper); }
  .ch-crumb [aria-current] { color: var(--paper); }
  .ch-hero-split { align-items: flex-end; margin-top: 40px; }
  .ch-kicker { color: var(--muted); }
  .ch-h1 { font-size: clamp(40px, 5.6vw, 84px); }
  .ch-logos { display: grid; gap: 12px; }
  .ch-logo { background: var(--tile); border-radius: 24px; height: 170px; display: flex; align-items: center; justify-content: center; }
  .ch-logo img { max-height: 92px; max-width: 64%; width: auto; object-fit: contain; }
  .ch-facts { margin: 72px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 24px; }
  .ch-facts > div { border-top: 1px solid var(--line); padding-top: 20px; }
  .ch-facts dt { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .ch-facts dd { margin: 12px 0 0; font-size: 17px; line-height: 1.5; }

  .ch-story { border-block: 1px solid var(--line); }
  .ch-stack { display: flex; flex-direction: column; gap: 16px; }
  .ch-card { display: grid; gap: 24px; padding: clamp(28px, 5vw, 64px); scroll-margin-top: 96px; }
  .ch-card:hover { transform: none; box-shadow: none; border-color: var(--light-line); }
  .ch-card .num, .ch-res-list .num { color: #A84B0C; }
  @media (min-width: 900px) {
    .ch-card { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 64px; }
    .ch-card-head { position: sticky; top: 112px; align-self: start; }
  }
  .ch-card-head h2 { margin: 14px 0 0; font-size: clamp(30px, 3vw, 40px); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; }
  .ch-card-body { min-width: 0; max-width: 72ch; }
  .ch-card-body p { font-size: 17px; line-height: 1.7; }
  .ch-title { margin: 0 0 20px; font-size: clamp(26px, 2.6vw, 36px); font-weight: 800; letter-spacing: -.03em; line-height: 1.15; }
  .ch-hl { color: #A84B0C; }
  .ch-pills { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; padding: 0; list-style: none; }
  .ch-pills li { border: 1px solid var(--line); border-radius: 999px; padding: 10px 18px; font-size: 14px; color: var(--ink); }
  .ch-did { border-top: 1px solid var(--line); padding: 28px 0 12px; max-width: none; }
  .ch-did:first-child { border-top: 0; padding-top: 0; }
  .ch-did h3 { margin: 0 0 12px; font-size: 22px; font-weight: 700; line-height: 1.3; display: flex; gap: 14px; align-items: baseline; }
  .ch-did h3 .num { font-size: 13px; flex: none; }
  .ch-did p { margin-left: 32px; font-size: 16px; }

  .ch-num .h2 { max-width: 760px; font-size: clamp(32px, 3.4vw, 48px); }
  .ch-num .h2 em { display: inline; font-style: italic; padding: 0; }
  .ch-num .lead { max-width: 620px; }
  .ch-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 32px; margin-top: 56px; }
  .ch-stats > div { border-top: 2px solid var(--line); padding-top: 24px; }
  .ch-stats .stat-n { margin: 0; font-size: clamp(40px, 3.5vw, 50px); }
  .ch-stat-l { margin: 14px 0 0; font-size: 16px; line-height: 1.5; color: var(--muted); max-width: 240px; }

  .ch-res-list { list-style: none; margin-block: 0; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ch-res-list .card { display: flex; flex-direction: column; gap: 40px; }
  .ch-res-list .h3 { font-size: 24px; }
  .ch-res-list p { font-size: 15px; line-height: 1.55; }

  .ch-quote { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 56px 80px; }
  .ch-video { flex: 0 1 340px; min-width: 0; position: relative; display: block; padding: 0; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; background: var(--card); cursor: pointer; margin-inline: auto; }
  .ch-video img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .ch-video .play { width: 76px; height: 76px; transition: transform .2s ease; }
  .ch-video:hover .play { transform: scale(1.06); }
  .ch-quote-text { flex: 999 1 480px; min-width: 0; }
  .ch-quote-text figure { margin: 0; }
  .ch-bq { margin: 24px 0 0; font-size: clamp(28px, 3.4vw, 48px); font-weight: 800; letter-spacing: -.03em; line-height: 1.12; }
  .ch-quote-text figcaption { margin-top: 32px; display: flex; flex-direction: column; gap: 4px; font-size: 15px; }
  .ch-name { font-size: 18px; font-weight: 700; }
  .ch-note { margin: 16px 0 0; font-size: 13px; }
  .ch-phil { margin-top: 48px; padding-top: 32px; scroll-margin-top: 96px; }
  .ch-phil-h { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .ch-tagline { margin: 14px 0 20px; font-size: 26px; font-weight: 800; letter-spacing: -.02em; line-height: 1.25; color: var(--accent); }
  .ch-phil .prose p { font-size: 16px; line-height: 1.65; }
  .ch-rel { margin-top: 28px; padding-top: 28px; }
  .ch-rel p { margin: 10px 0 0; max-width: 60ch; font-size: 16px; }
  .ch-rel .link-arrow { margin-top: 12px; }

  .ch-cta { border-radius: var(--r-big); padding: clamp(40px, 7vw, 104px) clamp(24px, 6vw, 88px); text-align: center; }
  .ch-cta:hover { transform: none; box-shadow: none; border-color: var(--light-line); }
  .ch-cta .eyebrow { justify-content: center; color: #A84B0C; }
  .ch-cta .h2 { max-width: 820px; margin-inline: auto; font-size: clamp(34px, 4.4vw, 64px); }
  .ch-cta .lead { margin-inline: auto; }
  .ch-cta .btns { justify-content: center; }
  @media (max-width: 1100px) { .ch-res-list, .ch-stats, .ch-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .ch-hero { padding-block: 32px 64px; }
    .ch-logos { grid-template-columns: 1fr 1fr; }
    .ch-logo { height: 112px; border-radius: 18px; }
    .ch-logo img { max-height: 64px; max-width: 72%; }
    .ch-facts { margin-top: 48px; gap: 28px 16px; }
    .ch-facts dd { font-size: 15px; }
    .ch-stats { gap: 32px 16px; margin-top: 40px; }
    .ch-stats .stat-n { font-size: 31px; }
    .ch-video { flex-basis: 100%; max-width: 280px; }
    .ch-did p { margin-left: 0; }
    .ch-res-list { grid-template-columns: 1fr; }
    .ch-res-list .card { gap: 20px; }
  }
</style>
</Page>

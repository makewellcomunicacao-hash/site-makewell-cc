---
// Serviços (artboard Servicos): hero escuro, integração, 6 serviços em fundo claro, como começamos (laranja),
// links para framework/método/cases e CTA final. Texto completo em src/content/services.ts.
import Page from '../layouts/Page.astro';
import { path, type Lang, type PageKey } from '../lib/site';
import content from '../content/services';

interface Props { page: { htmlAttrs: string; head: string; body: string }; key: PageKey; lang: Lang }
const { page, key, lang } = Astro.props;
const c = content[lang];
const ICONS = [
  'M12 3l8 6-8 12-8-12zM4 9h16M12 3v18',
  'M4 5h16v11H10l-6 4zM8 9h8M8 12h5',
  'M3 17l6-6 4 4 8-8M14 7h7v7',
  'M3 4h18l-7 8v6l-4 2v-8z',
  'M18 11a7 7 0 1 1-14 0a7 7 0 1 1 14 0M20 20l-4-4',
  'M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM10 2v4M14 2v4M10 18v4M14 18v4M2 10h4M2 14h4M18 10h4M18 14h4',
];
const more = (['framework', 'method', 'cases'] as const).map((k, i) => ({ href: path(k, lang), label: c.moreLinks[i] }));
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Page page={page} key={key} lang={lang}>
  <section class="t-warm sv-hero">
    <div class="wrap">
      <p class="eyebrow dot sv-kicker">{c.kicker}</p>
      <h1 class="h1 sv-h1"><span>{c.h1a}</span> <em>{c.h1b}</em></h1>
      <div class="sv-hero-row">
        <p class="lead">{c.lead}</p>
        <div class="btns">
          <a class="btn btn-primary" href="#diagnostico">{c.heroCta}</a>
          <a class="btn btn-ghost" href="#lista">{c.heroSec}</a>
        </div>
      </div>
      <img class="photo sv-hero-img" src="/images/escritorio-campanhas.webp" alt={c.heroAlt} width="1210" height="610" fetchpriority="high" />
    </div>
  </section>

  <section class="t-warm2 sec line-top">
    <div class="wrap split sv-why">
      <div class="main">
        <h2 class="eyebrow">{c.whyEyebrow}</h2>
        <p class="h2">{c.whyTitle}</p>
        <p class="lead">{c.whyText} <strong>{c.whyStrong}</strong></p>
        <ol class="sv-flow" aria-label={c.flowLabel}>
          {c.flow.map((f, i) => <li><span aria-hidden="true">{i + 1}</span>{f}</li>)}
        </ol>
      </div>
      <img class="photo side sv-why-img" src="/images/escritorio-estudio.webp" alt={c.officeAlt} width="1210" height="908" loading="lazy" />
    </div>
  </section>

  <section class="t-light sec" id="lista">
    <div class="wrap">
      <p class="eyebrow sv-eb-dark">{c.svEyebrow}</p>
      <div class="sv-head">
        <h2 class="h2">{c.svTitle}</h2>
        <p class="muted">{c.svSub}</p>
      </div>
      <div class="grid sv-grid">
        {c.services.map((s, i) => (
          <article class="card sv-card">
            <div class="sv-card-top">
              <span class="sv-icon"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[i]} /></svg></span>
              <span class="sv-num">{n(i)}</span>
            </div>
            <h3 class="h3">{s.title}</h3>
            <p>{s.lead}</p>
            <dl>
              {s.rows.map(([dt, dd], j) => <div class={j === 2 ? 'hl' : undefined}><dt>{dt}</dt><dd>{dd}</dd></div>)}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="t-accent sec" id={c.startId}>
    <div class="wrap">
      <p class="eyebrow">{c.startEyebrow}</p>
      <h2 class="h2 sv-h2-sm">{c.startTitle}</h2>
      <p class="lead">{c.startSub}</p>
      <ol class="grid sv-steps">
        {c.steps.map((s, i) => <li><p class="stat-n">{n(i)}</p><h3 class="h3">{s.title}</h3><p>{s.desc}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="t-warm sec">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">{c.moreEyebrow}</p>
        <h2 class="h2 sv-h2-sm">{c.moreTitle}</h2>
        <p class="lead">{c.moreSub}</p>
        <ul class="sv-more">
          {more.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
        </ul>
      </div>
      <figure class="side sv-partner">
        <figcaption class="eyebrow muted">{c.partners}</figcaption>
        <div class="tile"><img src="/images/logo-kommo-partner.webp" alt="Kommo Partner" width="1920" height="1080" loading="lazy" /></div>
        <p class="sr-only">{c.kommoLabel}</p>
      </figure>
    </div>
  </section>

  <section class="t-light sec" id="diagnostico">
    <div class="wrap">
      <div class="card sv-cta">
        <p class="eyebrow sv-cta-eyebrow">{c.ctaEyebrow}</p>
        <h2 class="h2">{c.ctaTitle}</h2>
        <p class="lead">{c.ctaText}</p>
        <div class="btns">
          <a class="btn btn-primary" href={c.ctaHref} target="_blank" rel="noopener noreferrer" data-track="lead" onclick={c.ctaOnclick}>{c.ctaBtn}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style is:inline>
  /* títulos sem palavra órfã (ex.: EN) */
  main :is(.h1, .h2, .h3) { text-wrap: balance; }
  .sv-hero { padding-block: clamp(72px, 9vw, 112px) clamp(64px, 7vw, 88px); }
  .sv-kicker { color: var(--muted); }
  .sv-h1 { max-width: 1100px; font-size: clamp(40px, 5.6vw, 84px); }
  .sv-h1 span { display: block; }
  .sv-hero-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0 64px; }
  .sv-hero-row .lead { flex: 1 1 480px; max-width: 640px; }
  .sv-hero-row .btns { margin-top: 32px; }
  .sv-hero-img { margin-top: 64px; height: clamp(240px, 40vw, 580px); border-radius: 24px; }
  .sv-why { align-items: center; }
  .sv-why .h2 { max-width: 16ch; }
  .sv-why .lead strong { color: var(--paper); }
  .split > .sv-why-img { flex-basis: 440px; aspect-ratio: 4 / 3; border-radius: 24px; }
  @media (min-width: 1100px) { .split > .sv-why-img { aspect-ratio: 4 / 5; } }
  .sv-flow { list-style: none; margin: 40px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .sv-flow li { display: flex; align-items: center; gap: 10px; border: 1px solid var(--line); border-radius: 999px; padding: 10px 18px 10px 10px; font-size: 15px; color: #D8D3CB; }
  .sv-flow span { display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 12px; font-weight: 800; }
  .sv-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 64px; }
  .sv-head .h2 { margin: 16px 0 0; }
  .sv-eb-dark { color: #B4530F; }
  .sv-head p { margin: 0; max-width: 440px; }
  .sv-grid { --min: min(100%, 320px); margin-top: 56px; }
  .sv-card { display: flex; flex-direction: column; }
  /* subgrid: rótulos "O que é / Pra quem serve / ..." na mesma altura entre os cards da linha */
  @supports (grid-template-rows: subgrid) {
    .sv-card { display: grid; grid-row: span 7; grid-template-rows: subgrid; row-gap: 0; }
    .sv-card dl { display: contents; }
    .sv-card dl div:first-child { margin-top: 24px; }
  }
  .sv-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
  .sv-icon { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 14px; border: 1px solid var(--line); }
  .sv-num { font-size: 14px; font-weight: 700; color: var(--muted); }
  .sv-card .h3 { font-size: 24px; }
  .sv-card > p { color: #3A352F; font-size: 15px; line-height: 1.55; }
  .sv-card dl { margin: 24px 0 0; }
  .sv-card dl div { border-top: 1px solid var(--line); padding: 14px 0; }
  .sv-card dl div:last-child { padding-bottom: 0; }
  .sv-card dt { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .sv-card dd { margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: #3A352F; }
  .sv-card .hl dt { color: #B4530F; }
  .sv-card .hl dd { color: var(--ink); }
  .sv-h2-sm { font-size: clamp(30px, 3.4vw, 48px); line-height: 1.08; }
  .t-accent .lead { color: var(--muted); max-width: 680px; }
  .sv-steps { --min: min(100%, 260px); gap: 40px 32px; margin: 56px 0 0; padding: 0; list-style: none; }
  .sv-steps li { border-top: 2px solid var(--on-accent); padding-top: 24px; }
  .sv-steps .stat-n { margin: 0; }
  .sv-steps .h3 { margin-top: 18px; }
  .sv-steps li > p:last-child { margin: 10px 0 0; color: var(--muted); }
  .sv-more { list-style: none; margin: 32px 0 0; padding: 0; }
  .sv-more a { display: block; border-top: 1px solid var(--line); padding: 22px 0; font-size: 20px; font-weight: 700; text-decoration: none; }
  .sv-more a:hover { color: var(--accent-2); }
  .sv-partner { margin: 0; }
  .sv-partner figcaption { margin-bottom: 20px; }
  .sv-partner .tile { height: 160px; border-radius: 20px; background: #fff; }
  .sv-partner .tile img { max-height: 64px; }
  .sv-cta { padding: clamp(36px, 6vw, 88px); border-radius: var(--r-big); text-align: center; }
  .sv-cta .eyebrow { justify-content: center; color: #B4530F; }
  .sv-cta .h2 { max-width: 820px; margin-inline: auto; font-size: clamp(34px, 4.4vw, 64px); }
  .sv-cta .lead { max-width: 560px; margin-inline: auto; }
  .sv-cta .btns { justify-content: center; }
</style>

---
// Rodapé completo em todas as páginas (antes só a home tinha): redes, texto da agência, navegação,
// conteúdo social, endereço/e-mail/CNPJ e parceiros. Textos copiados do rodapé da home atual de cada idioma.
import { NAV_KEYS, UI, path, type Lang, type PageKey } from '../lib/site';

interface Props { key: PageKey; lang: Lang }
const { key, lang } = Astro.props;
const t = UI[lang];
const F: Record<Lang, { agency: string; agencyDesc: string; navTitle: string; navLabels: string[]; social: string; socialDesc: string; socialLink: string; loc: string; copy: string; prefs: string }> = {
  br: { agency: 'A Agência', agencyDesc: 'A Makewell é uma agência de comunicação e performance especializada em marcas, vendas e posicionamento digital.', navTitle: 'Navegação', navLabels: ['Sobre', 'Serviços', 'Framework', 'Método', 'Cases'], social: 'Conteúdo Social', socialDesc: 'Conteúdo estratégico sobre marketing, vendas e posicionamento. Siga a Makewell no Instagram.', socialLink: '@makewellcomunicacao →', loc: 'Localização', copy: 'Copyright © 2026 Makewell | Todos os direitos reservados', prefs: 'Preferências de cookies' },
  en: { agency: 'The Agency', agencyDesc: 'Makewell is a communications and performance agency specializing in branding, sales, and digital positioning.', navTitle: 'Navigation', navLabels: ['About Us', 'Services', 'Framework', 'Method', 'Cases'], social: 'Blog & Content', socialDesc: 'Strategic content on marketing, sales and digital positioning. <strong>Coming soon.</strong>', socialLink: 'Follow on Instagram →', loc: 'Location', copy: 'Copyright © 2026 Makewell | All Rights Reserved', prefs: 'Cookie preferences' },
  es: { agency: 'La Agencia', agencyDesc: 'Makewell es una agencia de comunicación y performance especializada en branding, ventas y posicionamiento digital.', navTitle: 'Navegación', navLabels: ['Sobre Nosotros', 'Servicios', 'Framework', 'Método', 'Casos'], social: 'Blog y Contenido', socialDesc: 'Contenido estratégico sobre marketing, ventas y posicionamiento digital. <strong>Próximamente.</strong>', socialLink: 'Síguenos en Instagram →', loc: 'Ubicación', copy: 'Copyright © 2026 Makewell | Todos los Derechos Reservados', prefs: 'Preferencias de cookies' },
  pt: { agency: 'A Agência', agencyDesc: 'A Makewell é uma agência de comunicação e performance especializada em branding, vendas e posicionamento digital.', navTitle: 'Navegação', navLabels: ['Sobre Nós', 'Serviços', 'Framework', 'Método', 'Cases'], social: 'Blog & Conteúdo', socialDesc: 'Conteúdo estratégico sobre marketing, vendas e posicionamento digital. <strong>Brevemente.</strong>', socialLink: 'Siga no Instagram →', loc: 'Localização', copy: 'Copyright © 2026 Makewell | Todos os direitos reservados', prefs: 'Preferências de cookies' },
};
const f = F[lang];
const IG = 'https://www.instagram.com/makewellcomunicacao/';
const socials = [
  { name: 'Instagram', href: IG, d: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>' },
  { name: 'Facebook', href: 'https://www.facebook.com/makewellcomunicacao', d: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v7h4v-7h3l1-4h-4V8a0 0 0 0 1 0 0Z"/>' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/makewell-comunicacao', d: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@makewellcomunicacao', d: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 5"/>' },
];
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a href={path('home', lang)} aria-label={t.logoAria}><img class="logo" src="/images/logo-makewell-mi-branca.webp" alt={t.logoAlt} width="136" height="44" loading="lazy" /></a>
      <div class="foot-social">
        {socials.map((s) => <a href={s.href} aria-label={s.name} target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.d} /></a>)}
      </div>
    </div>
    <div class="foot-col">
      <p class="foot-title">{f.agency}</p>
      <p>{f.agencyDesc}</p>
    </div>
    <nav class="foot-col" aria-label={f.navTitle}>
      <p class="foot-title">{f.navTitle}</p>
      <ul>
        {NAV_KEYS.map((k, i) => <li><a href={path(k, lang)}>{f.navLabels[i]}</a></li>)}
        <li><a href={path('privacy', lang)}>{t.legal[0]}</a></li>
        <li><a href={path('terms', lang)}>{t.legal[1]}</a></li>
      </ul>
    </nav>
    <div class="foot-col">
      <p class="foot-title">{f.social}</p>
      <p set:html={f.socialDesc} />
      <a class="foot-link" href={IG} target="_blank" rel="noopener noreferrer">{f.socialLink}</a>
    </div>
    <div class="foot-col">
      <p class="foot-title">{f.loc}</p>
      <p>R. Prof. Lourenço Peixoto, 36, Sala 04, Jatiúca, Maceió, AL.</p>
      <p><a href="mailto:contato@makewell.com.br">contato@makewell.com.br</a></p>
      <p>{t.taxId}</p>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <p>{f.copy} &middot; {t.places}</p>
    <p class="mw-prefs-line"><button type="button" class="mw-cookie-prefs">{f.prefs}</button></p>
    <div class="partners">
      <span><Fragment set:html={t.partners} /></span>
      <img src="/images/logo-kommo-partner.webp" alt="Kommo Partner" width="160" height="48" loading="lazy" />
    </div>
  </div>
</footer>

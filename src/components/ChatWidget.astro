---
// Chat de vendas (assistente de IA) no botão flutuante. O servidor é o Worker em chat/ (chat.makewell.agency).
// Nada é carregado antes de o visitante escrever: a saudação é texto fixo daqui. A conversa continua entre páginas
// (sessionStorage) e, quando o lead está pronto, aparece "Continuar no WhatsApp" com o resumo já escrito.
import { path, type Lang } from '../lib/site';
interface Props { lang: Lang; wa: string }
const { lang, wa } = Astro.props;
const T: Record<Lang, Record<string, string>> = {
  br: { teaser: 'Oi! Sou a Maia. Posso te ajudar a ver o que faz sentido para o seu negócio?', open: 'Conversar com a Makewell', title: 'Maia · Makewell', close: 'Fechar conversa', greet: 'Oi! Sou a Maia, assistente de IA da Makewell. Me conta rapidinho: qual é o seu negócio e o que você quer melhorar no marketing hoje?', notice: 'Você está conversando com uma IA. A conversa fica guardada por 90 dias e, se você seguir para o WhatsApp, um resumo vai para o nosso time.', privacy: 'Política de privacidade', ph: 'Escreva sua mensagem…', send: 'Enviar', wa: 'Prefiro falar no WhatsApp', cta: 'Continuar no WhatsApp', typing: 'Digitando…', error: 'Não consegui responder agora. Fale com o time pelo WhatsApp, por favor.' },
  en: { teaser: "Hi! I'm Maia. Can I help you see what makes sense for your business?", open: 'Chat with Makewell', title: 'Maia · Makewell', close: 'Close chat', greet: "Hi! I'm Maia, Makewell's AI assistant. Tell me a bit about your business: what would you like to improve in your marketing right now?", notice: "You're chatting with an AI. The conversation is kept for 90 days, and if you continue on WhatsApp, a summary goes to our team.", privacy: 'Privacy policy', ph: 'Type your message…', send: 'Send', wa: "I'd rather use WhatsApp", cta: 'Continue on WhatsApp', typing: 'Typing…', error: "I couldn't reply just now. Please reach the team on WhatsApp." },
  es: { teaser: '¡Hola! Soy Maia. ¿Te ayudo a ver qué tiene sentido para tu negocio?', open: 'Conversar con Makewell', title: 'Maia · Makewell', close: 'Cerrar conversación', greet: '¡Hola! Soy Maia, la asistente de IA de Makewell. Cuéntame: ¿cuál es tu negocio y qué te gustaría mejorar en tu marketing hoy?', notice: 'Estás conversando con una IA. La conversación se guarda durante 90 días y, si sigues por WhatsApp, un resumen llega a nuestro equipo.', privacy: 'Política de privacidad', ph: 'Escribe tu mensaje…', send: 'Enviar', wa: 'Prefiero hablar por WhatsApp', cta: 'Continuar en WhatsApp', typing: 'Escribiendo…', error: 'No pude responder ahora. Habla con el equipo por WhatsApp, por favor.' },
  pt: { teaser: 'Olá! Sou a Maia. Posso ajudá-lo a perceber o que faz sentido para o seu negócio?', open: 'Conversar com a Makewell', title: 'Maia · Makewell', close: 'Fechar conversa', greet: 'Olá! Sou a Maia, assistente de IA da Makewell. Conte-me: qual é o seu negócio e o que gostaria de melhorar no seu marketing?', notice: 'Está a conversar com uma IA. A conversa fica guardada durante 90 dias e, se seguir para o WhatsApp, um resumo vai para a nossa equipa.', privacy: 'Política de privacidade', ph: 'Escreva a sua mensagem…', send: 'Enviar', wa: 'Prefiro falar no WhatsApp', cta: 'Continuar no WhatsApp', typing: 'A escrever…', error: 'Não consegui responder agora. Fale com a equipa pelo WhatsApp, por favor.' },
};
const t = T[lang];
---
<button type="button" class="wa-float mw-chat-btn" id="mwChatBtn" aria-label={t.open} aria-expanded="false" aria-controls="mwChat">
  <img src="/images/maia-botao.webp" alt="" width="56" height="56" />
</button>
<div class="mw-chat-teaser" id="mwChatTeaser" hidden>
  <button type="button" class="mw-teaser-open">{t.teaser}</button>
  <button type="button" class="mw-teaser-x" aria-label={t.close}>&times;</button>
</div>
<section class="mw-chat" id="mwChat" role="dialog" aria-label={t.title} hidden data-lang={lang} data-endpoint="https://chat.makewell.agency/chat" data-wa={wa}
  data-t-typing={t.typing} data-t-error={t.error} data-t-cta={t.cta}>
  <header class="mw-chat-head">
    <img class="mw-chat-mark" src="/images/maia-avatar.webp" alt="" width="96" height="96" />
    <p class="mw-chat-title">{t.title} <span class="mw-chat-badge">IA</span></p>
    <button type="button" class="mw-chat-close" aria-label={t.close}>&times;</button>
  </header>
  <p class="mw-chat-notice">{t.notice} <a href={path('privacy', lang)}>{t.privacy}</a></p>
  <div class="mw-chat-log" aria-live="polite"><p class="mw-msg mw-ai">{t.greet}</p></div>
  <form class="mw-chat-form">
    <textarea rows="1" maxlength="1200" placeholder={t.ph} aria-label={t.ph} required></textarea>
    <button type="submit" class="mw-chat-send" aria-label={t.send}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </form>
  <a class="mw-chat-wa" href={wa} target="_blank" rel="noopener noreferrer">{t.wa}</a>
</section>
<script is:inline>
(function () {
  var box = document.getElementById('mwChat'), btn = document.getElementById('mwChatBtn'); if (!box || !btn) return;
  var log = box.querySelector('.mw-chat-log'), form = box.querySelector('.mw-chat-form'), input = form.querySelector('textarea');
  var KEY = 'mw-chat-' + box.dataset.lang, state = { sid: '', msgs: [] }, busy = false;
  try { state = JSON.parse(sessionStorage.getItem(KEY)) || state; } catch (e) {}
  var save = function () { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} };
  function bubble(who, text) { var p = document.createElement('p'); p.className = 'mw-msg ' + (who === 'me' ? 'mw-me' : 'mw-ai'); p.textContent = text; log.appendChild(p); log.scrollTop = log.scrollHeight; return p; }
  function cta(url) {
    var a = document.createElement('a'); a.className = 'btn btn-primary mw-chat-cta'; a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = box.dataset.tCta;
    a.addEventListener('click', function () { try { fbq('track', 'Lead', { content_name: 'Chat IA' }); } catch (e) {} });
    log.appendChild(a); log.scrollTop = log.scrollHeight;
  }
  state.msgs.forEach(function (m) { if (m.who === 'cta') cta(m.text); else bubble(m.who, m.text); });
  function toggle(o) {
    box.hidden = !o; btn.setAttribute('aria-expanded', o); document.documentElement.classList.toggle('mw-chat-open', o);
    if (o) { input.focus(); log.scrollTop = log.scrollHeight; } else btn.focus();
  }
  btn.addEventListener('click', function () { toggle(box.hidden); });
  // iniciativa: depois de 30s navegando no site (contados entre páginas), um balão chama para a conversa, uma vez por
  // visita; espera o aviso de cookies sair e o botão aparecer (no celular, só depois de rolar)
  var teaser = document.getElementById('mwChatTeaser'), ss = window.sessionStorage, t0;
  try { t0 = +ss.getItem('mw-chat-t0') || Date.now(); ss.setItem('mw-chat-t0', t0); } catch (e) { t0 = Date.now(); }
  function seen() { try { return ss.getItem('mw-chat-teased'); } catch (e) { return 1; } }
  function hideTeaser() { teaser.hidden = true; try { ss.setItem('mw-chat-teased', 1); } catch (e) {} }
  function tease() {
    if (seen() || state.msgs.length || !box.hidden) return;
    var c = document.getElementById('mw-consent');
    if ((c && !c.hidden) || getComputedStyle(btn).opacity < 0.5) return setTimeout(tease, 4000);
    teaser.hidden = false; try { ss.setItem('mw-chat-teased', 1); } catch (e) {}
  }
  if (!seen() && !state.msgs.length) setTimeout(tease, Math.max(5000, 30000 - (Date.now() - t0))); // 5s no mínimo: o aviso de cookies aparece depois do carregamento
  teaser.querySelector('.mw-teaser-open').addEventListener('click', function () { hideTeaser(); toggle(true); });
  teaser.querySelector('.mw-teaser-x').addEventListener('click', hideTeaser);
  btn.addEventListener('click', hideTeaser);
  box.querySelector('.mw-chat-close').addEventListener('click', function () { toggle(false); });
  box.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
  form.addEventListener('submit', function (e) {
    e.preventDefault(); var text = input.value.trim(); if (!text || busy) return;
    busy = true; input.value = ''; bubble('me', text); state.msgs.push({ who: 'me', text: text }); save();
    var dots = bubble('ai', box.dataset.tTyping); dots.classList.add('mw-typing');
    fetch(box.dataset.endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ sid: state.sid, lang: box.dataset.lang, text: text, page: location.pathname }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        dots.remove(); if (d.sid) state.sid = d.sid;
        var reply = d.reply || (d.error ? box.dataset.tError : '');
        if (reply) { bubble('ai', reply); state.msgs.push({ who: 'ai', text: reply }); }
        if (d.whatsapp) { cta(d.whatsapp); state.msgs.push({ who: 'cta', text: d.whatsapp }); }
        save();
      })
      .catch(function () { dots.remove(); bubble('ai', box.dataset.tError); cta(box.dataset.wa); })
      .finally(function () { busy = false; input.focus(); });
  });
})();
</script>
